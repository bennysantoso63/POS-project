source_location": "L89"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculaterfm", "callee": "prepare", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L100"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculaterfm", "callee": "this.db.transaction(() => {\n        for (const row of rfmData) {\n          // Simple Scoring Normalization (Base 0-5 for calculation)\n          const rScore = row.recency < 7 ? 5 : row.recency < 14 ? 4 : row.recency < 30 ? 3 : row.recency < 90 ? 2 : 1;\n          const fScore = row.frequency > 10 ? 5 : row.frequency > 5 ? 4 : row.frequency > 2 ? 3 : 2;\n          const mScore = row.monetary > 2000000 ? 5 : row.monetary > 1000000 ? 4 : row.monetary > 500000 ? 3 : 2;\n\n          // Hitung rfm_score dari R, F, M yang sudah dinormalisasi (Weighting: 30%, 30%, 40%)\n          const rfmScore = (rScore * 0.3 + fScore * 0.3 + mScore * 0.4) * 20;\n\n          let rfmLabel;\n          if (rfmScore >= 80)                              rfmLabel = 'vip';\n          else if (rfmScore >= 60)                         rfmLabel = 'loyal';\n          else if (rfmScore >= 40)                         rfmLabel = 'potential';\n          else if (row.recency < 90 && rfmScore < 40)      rfmLabel = 'at_risk';\n          else                                             rfmLabel = 'churned';\n\n          insertRfm.run(\n            row.customer_id,\n            Math.floor(row.recency),\n            row.frequency,\n            row.monetary,\n            Math.round(rfmScore),\n            rfmLabel\n          );\n        }\n      })", "is_member_call": false, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L106"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculaterfm", "callee": "transaction", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L106"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculaterfm", "callee": "error", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L136"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "info", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L145"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "all", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L149"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "prepare", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L149"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "run", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L163"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "prepare", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L163"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "prepare", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L164"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "this.db.transaction(() => {\n        for (const rule of rules) {\n          insertRule.run(rule.primary_id, rule.secondary_id, 85); // Dummy confidence for POC\n        }\n      })", "is_member_call": false, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L166"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "transaction", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L166"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_recalculateapriori", "callee": "error", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L174"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_getbundlingsuggestion", "callee": "prepare", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L186"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_getbundlingsuggestion", "callee": "get", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L195"}, {"caller_nid": "electron_linglingdatascience_linglingdatascience_getbundlingsuggestion", "callee": "error", "is_member_call": true, "source_file": "C:\\Users\\wewe\\.gemini\\antigravity\\scratch\\barcode-sistem\\electron\\LingLingDataScience.js", "source_location": "L199"}]}