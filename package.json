{
  "name": "pos-offline-mandiri",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "concurrently \"vite\" \"electron .\"",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "bwip-js": "^4.10.1",
    "cors": "^2.8.6",
    "electron-log": "^5.4.3",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.344.0",
    "lunar-javascript": "^1.7.7",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "server-destroy": "^1.0.1",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^4.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.pos.offline",
    "productName": "Ling-Ling POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/db/**/*",
      "src/utils/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/escpos/**/*",
      "node_modules/escpos-usb/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
